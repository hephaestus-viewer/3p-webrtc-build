+// ----------------------------------------------------------------------------
+//  Device-change notifications (webrtc-sdk/webrtc)
+// ----------------------------------------------------------------------------
+
+int32_t AudioDeviceWindowsCore::SetObserver(AudioDeviceObserver* observer) {
+  _deviceStateListener->SetObserver(observer);
+  return 0;
+}
+
+void AudioDeviceWindowsCore::DeviceStateListener::SetObserver(
+    AudioDeviceObserver* observer) {
+  observer_.store(observer);
+}
+
+// As in webrtc-sdk, a device's state change (plugged in, unplugged, enabled,
+// disabled) is what gets reported; the other notifications are only logged.
+HRESULT AudioDeviceWindowsCore::DeviceStateListener::OnDeviceStateChanged(
+    LPCWSTR /* pwstrDeviceId */,
+    DWORD dwNewState) {
+  RTC_DLOG(LS_INFO) << "Core Audio device state changed to " << dwNewState;
+  if (AudioDeviceObserver* observer = observer_.load()) {
+    observer->OnDevicesUpdated();
+  }
+  return S_OK;
+}
+
+HRESULT AudioDeviceWindowsCore::DeviceStateListener::OnDeviceAdded(
+    LPCWSTR /* pwstrDeviceId */) {
+  RTC_DLOG(LS_INFO) << "Core Audio device added";
+  return S_OK;
+}
+
+HRESULT AudioDeviceWindowsCore::DeviceStateListener::OnDeviceRemoved(
+    LPCWSTR /* pwstrDeviceId */) {
+  RTC_DLOG(LS_INFO) << "Core Audio device removed";
+  return S_OK;
+}
+
+HRESULT AudioDeviceWindowsCore::DeviceStateListener::OnDefaultDeviceChanged(
+    EDataFlow /* flow */,
+    ERole /* role */,
+    LPCWSTR /* pwstrDefaultDeviceId */) {
+  RTC_DLOG(LS_INFO) << "Core Audio default device changed";
+  return S_OK;
+}
+
+HRESULT AudioDeviceWindowsCore::DeviceStateListener::OnPropertyValueChanged(
+    LPCWSTR /* pwstrDeviceId */,
+    const PROPERTYKEY /* key */) {
+  return S_OK;
+}
+
+ULONG AudioDeviceWindowsCore::DeviceStateListener::AddRef() {
+  return InterlockedIncrement(&ref_count_);
+}
+
+ULONG AudioDeviceWindowsCore::DeviceStateListener::Release() {
+  // Owned by AudioDeviceWindowsCore, which deletes it after unregistering.
+  return InterlockedDecrement(&ref_count_);
+}
+
+HRESULT AudioDeviceWindowsCore::DeviceStateListener::QueryInterface(
+    REFIID iid,
+    void** object) {
+  if (object == nullptr) {
+    return E_POINTER;
+  }
+  if (iid == IID_IUnknown || iid == __uuidof(IMMNotificationClient)) {
+    *object = static_cast<IMMNotificationClient*>(this);
+    return S_OK;
+  }
+  *object = nullptr;
+  return E_NOINTERFACE;
+}
