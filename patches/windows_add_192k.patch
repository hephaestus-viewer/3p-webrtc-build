+// Tells the system not to duck (attenuate) other applications' audio while this
+// render stream is active. Uses IAudioClientDuckingControl, which is the
+// documented way for a communication app to avoid triggering the default
+// ducking experience. It is available on Windows 10 Build 20348 and later; on
+// older systems GetService() fails and we simply keep the default behavior.
+// The interface must be obtained from an initialized render IAudioClient, so
+// call this after Initialize() and before Start(). Non-fatal on any failure.
+void DisableDuckingOfOtherStreams(IAudioClient* render_client) {
+#if defined(__IAudioClientDuckingControl_INTERFACE_DEFINED__)
+  if (!render_client) {
+    return;
+  }
+  IAudioClientDuckingControl* ducking_control = nullptr;
+  HRESULT hr = render_client->GetService(IID_PPV_ARGS(&ducking_control));
+  if (FAILED(hr) || !ducking_control) {
+    RTC_LOG(LS_WARNING)
+        << "GetService(IAudioClientDuckingControl) unavailable (requires "
+           "Windows 10 build 20348+): 0x"
+        << ToHex(hr);
+    return;
+  }
+  hr = ducking_control->SetDuckingOptionsForCurrentStream(
+      AUDIO_DUCKING_OPTIONS_DO_NOT_DUCK_OTHER_STREAMS);
+  if (FAILED(hr)) {
+    RTC_LOG(LS_WARNING) << "SetDuckingOptionsForCurrentStream() failed: 0x"
+                        << ToHex(hr);
+  } else {
+    RTC_LOG(LS_INFO) << "Disabled ducking of other applications' audio";
+  }
+  SAFE_RELEASE(ducking_control);
+#else
+  RTC_LOG(LS_WARNING) << "IAudioClientDuckingControl not available in this SDK; "
+                         "cannot disable ducking of other streams";
+#endif
+}
